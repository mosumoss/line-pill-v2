# LINE LIFF チャネル ID (LINE Developers Console で取得)
VITE_LIFF_ID=1234567890-xxxxxxxx

# バックエンド API ベース URL
# 開発: cloudflared named tunnel URL (https://pill.example.workers.dev)
# 本番: 同じ URL (v2では固定)
VITE_API_BASE=https://your-tunnel.trycloudflare.com

# 開発時にLIFF SDKをモックする場合は true
VITE_LIFF_MOCK=false
